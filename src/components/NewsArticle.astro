---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { newsStrings, formatDate, type Lang, type NewsEntry } from '../lib/news';

interface Props { lang: Lang; entry: NewsEntry }
const { lang, entry } = Astro.props;
const t = newsStrings[lang];
const { Content } = await render(entry);
const { title, date, category, summary, image, imageAlt, source } = entry.data;
---

<BaseLayout title={title} description={summary} lang={lang}>
  <article class="py-12">
    <div class="container max-w-3xl">
      <a href={`/${lang}/news`} class="text-primary hover:underline">← {t.back}</a>
      <div class="flex flex-wrap items-center gap-3 text-sm mt-6 mb-3">
        <span class="px-2 py-0.5 rounded bg-primary/10 text-primary font-medium">{t.categories[category]}</span>
        <time datetime={date.toISOString().slice(0, 10)} class="text-gray-500">{formatDate(date, lang)}</time>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold mb-6">{title}</h1>
      {image && <img src={image} alt={imageAlt ?? ''} class="w-full rounded-lg mb-8" />}
      <div class="news-body">
        <Content />
      </div>
      {source && (
        <p class="mt-8 pt-4 border-t border-gray-200 text-sm text-gray-600">
          {t.source}: <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">{source.name}</a>
        </p>
      )}
    </div>
  </article>
</BaseLayout>
