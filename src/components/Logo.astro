---
// Apollo brand mark: the letter A doubles as a roof, its crossbar is the
// horizon and the sun rises beneath it. Same geometry as public/favicon.svg.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg class={className} viewBox="0 0 100 100" aria-hidden="true">
  <polygon points="50,6 92,94 77,94 50,37.4 23,94 8,94" class="fill-primary" />
  <rect x="26" y="72" width="48" height="7" class="fill-primary" />
  <path d="M38 72 A12 12 0 0 1 62 72 Z" class="fill-secondary" />
</svg>
