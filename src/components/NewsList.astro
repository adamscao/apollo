---
import { getNews, splitId, newsStrings, formatDate, type Lang } from '../lib/news';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = newsStrings[lang];
const items = await getNews(lang);
---

{items.length > 0 && (
  <div class="space-y-8">
    {items.map(item => {
      const { slug } = splitId(item.id);
      const href = `/${lang}/news/${slug}`;
      return (
        <article class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden md:flex">
          {item.data.image && (
            <a href={href} class="md:w-72 md:flex-shrink-0 block">
              <img src={item.data.image} alt={item.data.imageAlt ?? ''} loading="lazy" class="w-full h-48 md:h-full object-cover" />
            </a>
          )}
          <div class="p-6">
            <div class="flex flex-wrap items-center gap-3 text-sm mb-2">
              <span class="px-2 py-0.5 rounded bg-primary/10 text-primary font-medium">{t.categories[item.data.category]}</span>
              <time datetime={item.data.date.toISOString().slice(0, 10)} class="text-gray-500">{formatDate(item.data.date, lang)}</time>
            </div>
            <h2 class="text-xl font-bold mb-2"><a href={href} class="hover:text-primary transition-colors">{item.data.title}</a></h2>
            <p class="mb-4 text-gray-700">{item.data.summary}</p>
            <a href={href} class="text-primary font-semibold hover:underline">{t.readMore} →</a>
          </div>
        </article>
      );
    })}
  </div>
)}

{items.length === 0 && <slot name="empty" />}
