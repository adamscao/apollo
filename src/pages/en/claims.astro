
---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Define the language
const lang = 'en';

// Legal process between the client and the insurance company (not Apollo)
const claimSteps = [
  {
    step: 1,
    title: 'At the Scene of the Accident',
    description: 'If anyone is injured, call 911 immediately. Then complete a Joint Report (Constat Amiable) together with the other driver and each sign it. Signing only confirms the identities of both parties and what happened — it is not an admission of fault.',
    icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z'
  },
  {
    step: 2,
    title: 'Notify Your Insurance Company',
    description: 'Contact your own insurance company within a reasonable time to report what happened, providing your policy number and the date, time, and location of the accident.',
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
  },
  {
    step: 3,
    title: 'The Insurer Assigns a Claims Adjuster',
    description: 'Your insurance company will assign a claims adjuster to follow up on your case and determine liability based on the circumstances of the accident and applicable rules such as the CID (Convention d\'indemnisation directe).',
    icon: 'M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z'
  },
  {
    step: 4,
    title: 'Submit Supporting Documents',
    description: 'Provide the documents requested by the adjuster, such as a police report (if applicable), accident photos, repair quotes, your driver\'s license, and vehicle registration.',
    icon: 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z'
  },
  {
    step: 5,
    title: 'Claim Decision',
    description: 'Once the adjuster completes the assessment, they will inform you of the decision, including the compensation amount and method; if the claim is denied, they will explain why and outline your appeal options.',
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'
  },
  {
    step: 6,
    title: 'Payment',
    description: 'Once a claim is approved, the insurance company typically pays out by bank transfer.',
    icon: 'M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2z'
  }
];

// Supplementary support Apollo can offer — kept visually and semantically
// separate from the legal process above so clients don't mistake it for
// part of the insurer's claims procedure. Apollo is not licensed to
// adjust claims, so wording avoids implying Apollo makes claims decisions.
const apolloSupport = [
  {
    title: 'Language & Document Assistance',
    description: 'If you find it difficult to communicate with the insurance company\'s claims adjuster, or need help preparing or filling out claims-related documents, feel free to contact us — we can help you organize your paperwork.',
    icon: 'M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z'
  },
  {
    title: 'Follow-up on Delays',
    description: 'If you\'ve already submitted your information but haven\'t heard back from the claims adjuster after a week or two, contact us and we can help follow up.',
    icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'
  },
  {
    title: 'Communication Support',
    description: 'If you and the claims adjuster disagree on something, you can also contact us — we can help you communicate with the insurance company and ask about the situation.',
    icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z'
  },
  {
    title: 'Ongoing Tracking',
    description: 'We offer a claims-tracking service, staying in touch and following your claim\'s progress until it is fully resolved.',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01'
  }
];
---

<BaseLayout title="Claims Process" lang={lang}>
  <section class="bg-gradient-to-r from-primary to-accent text-white py-12 md:py-16">
    <div class="container">
      <h1 class="text-center">Claims Process</h1>
      <p class="text-center max-w-3xl mx-auto mt-4">Understand how to complete the insurance claims process quickly and conveniently</p>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="mb-6">Insurance Company's Claims Process</h2>
        <p>Below is the standard claims process between you and your insurance company (based on Quebec regulations and your policy terms). Every judgment and decision at each step is made by the insurance company or its claims adjuster.</p>
      </div>

      <div class="relative">
        <!-- Vertical timeline (only displayed on large screens) -->
        <div class="hidden md:block absolute left-1/2 -ml-0.5 w-1 h-full bg-gray-200"></div>

        {claimSteps.map((step, index) => (
          <div class={`flex flex-col md:flex-row items-center md:items-start mb-12 last:mb-0 ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`}>
            <!-- Step number circle -->
            <div class="relative z-10 flex-shrink-0 flex items-center justify-center w-12 h-12 bg-primary text-white rounded-full font-bold mb-4 md:mb-0">
              {step.step}
            </div>

            <!-- Content box -->
            <div class={`flex-1 md:max-w-[calc(50%-2rem)] px-6 py-4 bg-light rounded-lg shadow-sm ${index % 2 === 0 ? 'md:mr-8 text-right' : 'md:ml-8'}`}>
              <div class={`flex items-start ${index % 2 === 0 ? 'flex-row-reverse' : ''}`}>
                <div class={`mt-1 text-primary ${index % 2 === 0 ? 'ml-4' : 'mr-4'}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={step.icon} />
                  </svg>
                </div>
                <div class={index % 2 === 0 ? 'text-right' : 'text-left'}>
                  <h3 class="text-xl font-semibold mb-2">{step.title}</h3>
                  <p>{step.description}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="max-w-3xl mx-auto mt-4 bg-white border border-gray-200 rounded-lg shadow-sm p-6">
        <h3 class="text-xl font-semibold mb-4 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Accident Report Form (Constat Amiable)
        </h3>
        <p class="mb-4">The official online accident report form is currently only available in English and French. You can also download the original French blank form, or refer to the Chinese reference translation alongside it.</p>
        <div class="flex flex-wrap gap-3">
          <a href="https://infoassurance.ca/en/joint-report" target="_blank" rel="noopener noreferrer" class="btn bg-light text-dark border border-gray-300 hover:bg-gray-100">Fill Online (English)</a>
          <a href="https://infoassurance.ca/constat-amiable/" target="_blank" rel="noopener noreferrer" class="btn bg-light text-dark border border-gray-300 hover:bg-gray-100">Fill Online (French)</a>
          <a href="/documents/constat-amiable-2023-fr.pdf" target="_blank" rel="noopener noreferrer" class="btn bg-light text-dark border border-gray-300 hover:bg-gray-100">Download Official Form (French, PDF)</a>
          <a href="/documents/constat-amiable-2023-cn.pdf" target="_blank" rel="noopener noreferrer" class="btn-primary">Download Reference Translation (Chinese, PDF)</a>
        </div>
        <p class="mt-4 text-sm text-dark/70">The Chinese reference translation is provided for comparison only; if it differs from the official French text, the French original prevails. Completing and signing the accident report form does not constitute an admission of fault.</p>
      </div>
    </div>
  </section>

  <section class="py-12 bg-light">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-center mb-8">Claims Information</h2>

        <div class="bg-white p-6 rounded-lg shadow-sm mb-6">
          <h3 class="text-xl font-semibold mb-4">Important Reminders</h3>
          <ul class="space-y-3">
            <li class="flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary mr-2 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>Contact us as soon as possible after an insurance incident to avoid delays in claims processing.</span>
            </li>
            <li class="flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary mr-2 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>Keep all relevant evidence, such as incident photos, repair receipts, medical reports, etc.</span>
            </li>
            <li class="flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary mr-2 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>In serious incidents, prioritize personal safety and notify police and emergency services as appropriate.</span>
            </li>
          </ul>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm">
          <h3 class="text-xl font-semibold mb-4">Common Required Documents</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <h4 class="font-medium text-primary mb-2">Home Insurance Claims</h4>
              <ul class="space-y-1">
                <li>• Property loss inventory</li>
                <li>• Damage photos</li>
                <li>• Repair quotes</li>
                <li>• Purchase receipts (if available)</li>
                <li>• Police report (if applicable)</li>
              </ul>
            </div>
            <div>
              <h4 class="font-medium text-primary mb-2">Auto Insurance Claims</h4>
              <ul class="space-y-1">
                <li>• Accident report</li>
                <li>• Vehicle damage photos</li>
                <li>• Repair quotes</li>
                <li>• Driver's license and vehicle registration</li>
                <li>• Police report (if applicable)</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-4">
        <h2 class="mb-6">Support Apollo Can Offer</h2>
        <p>The following services are provided by Apollo Insurance as customer support and are <strong>not part of the insurance company's claims process</strong>. The insurance company has not outsourced claims handling to us, and we do not hold a claims-adjusting license — the final judgment and decision on any claim always rests with the insurance company's claims adjuster. We can only provide supplementary support.</p>
      </div>

      <div class="max-w-3xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-6 mt-8">
        {apolloSupport.map((item) => (
          <div class="bg-white border-l-4 border-accent rounded-lg shadow-sm p-6">
            <div class="flex items-start">
              <div class="mt-1 text-accent mr-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold mb-2">{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="container text-center">
      <h2 class="mb-6">Need Help?</h2>
      <p class="max-w-2xl mx-auto mb-8">If you have any questions about the claims process or need to submit a claim, please contact our customer service team at any time. We will provide professional Chinese language support.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={`/${lang}/contact`} class="btn-primary">Contact Us</a>
        <a href={`/${lang}/faq`} class="btn bg-light text-dark border border-gray-300 hover:bg-gray-100">View FAQ</a>
      </div>
    </div>
  </section>
</BaseLayout>
