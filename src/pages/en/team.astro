
---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Define the language
const lang = 'en';

// Company switchboard, shared by every team member
const MAIN_PHONE = '450-676-3356';

// Team members data
const teamMembers = [
  {
    name: '曹梦阳 (Jacques)',
    title: 'General Manager',
    direct: '450-912-6302',
    extension: '324',
    email: 'jcao@assurancespv.com',
    wechat: '/team/cao.jpg'
  },
  {
    name: '许媛媛 (Justine)',
    title: 'Account Manager',
    direct: '450-912-6305',
    extension: '323',
    email: 'jxu@assurancespv.com',
    wechat: '/team/xu.jpg'
  },
  {
    name: '李辉 (Lily)',
    title: 'Account Manager',
    direct: '450-912-6303',
    extension: '303',
    email: 'lli@assurancespv.com',
    wechat: '/team/li.jpg'
  },
  {
    name: '武冬梅 (May)',
    title: 'Account Manager',
    direct: '450-912-6304',
    extension: '334',
    email: 'mwu@assurancespv.com',
    wechat: '/team/wu.jpg'
  },
  {
    name: '裴小佳 (Brigitte)',
    title: 'Account Manager',
    direct: '450-912-4835',
    extension: '336',
    email: 'bpei@assurancespv.com',
    wechat: '/team/pei.jpg'
  },
  {
    name: 'Lucie Dagenais',
    title: 'Head of Accounting',
    direct: '450-676-7707',
    email: 'interac@assurancespv.com',
    tip: '💡 Payment tip: To pay by e-Transfer, send to interac@assurancespv.com (note: the first letter is a lowercase "i"). Security question: "service rendu", answer: "assurance". Please include your name and policy number in the comment field.'
  },
  {
    name: 'France Robidoux',
    title: 'Business Insurance Assistant',
    extension: '329',
    email: 'frobidoux@assurancespv.com',
    tip: "💡 Finding your policy: To locate your business insurance e-policy, search your inbox for frobidoux@assurancespv.com — all our e-policies are sent from this address. If you can't find it, please check your spam folder."
  }
];
---

<BaseLayout title="Our Team" lang={lang}>
  <section class="bg-gradient-to-r from-primary to-accent text-white py-12 md:py-16">
    <div class="container">
      <h1 class="text-center">Our Team</h1>
      <p class="text-center max-w-3xl mx-auto mt-4">Our professional team is dedicated to providing you with the highest quality insurance services</p>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="mb-6">Meet Our Team</h2>
        <p>Apollo Insurance has a professional, dedicated team, with each member having extensive experience in the insurance industry, committed to providing professional, attentive service to clients. Our team members are fluent in Chinese and local official languages, able to provide service in your native language, eliminating communication barriers.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {teamMembers.map((member) => (
          <div class="bg-light rounded-lg overflow-hidden shadow-sm p-6">
            <h3 class="text-xl font-semibold mb-1">{member.name}</h3>
            <p class="text-primary font-medium mb-3">{member.title}</p>
            <div class="space-y-1 text-gray-700">
              <p>Switchboard: {MAIN_PHONE}{member.extension ? ` ext. ${member.extension}` : ''}</p>
              {member.direct && <p>Direct line: {member.direct}</p>}
            </div>
            <p class="mt-1 mb-3">Email: <a href={`mailto:${member.email}`} class="hover:text-primary">{member.email}</a></p>
            {member.tip && (
              <div class="mb-3 p-3 bg-white border-l-4 border-secondary rounded text-sm text-gray-600">{member.tip}</div>
            )}
            {member.wechat && (
              <div class="pt-3 border-t border-gray-200 flex items-center gap-3">
                <img src={member.wechat} alt={`${member.name} WeChat QR code`} class="w-20 h-20 object-cover rounded-lg border border-gray-200" />
                <span class="text-sm text-gray-600">WeChat QR Code</span>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-light">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="mb-6">Our Commitment</h2>
        <p>As members of the Apollo Insurance team, we are committed to providing professional, honest, efficient service to every client, helping you choose the most suitable insurance plans and protecting your property and interests.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-8 rounded-lg shadow-sm text-center">
          <div class="w-16 h-16 bg-primary/10 text-primary rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-8 h-8">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Professional Integrity</h3>
          <p>We provide transparent, reliable insurance services with professional knowledge and integrity, building long-term trust relationships with clients.</p>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-sm text-center">
          <div class="w-16 h-16 bg-primary/10 text-primary rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-8 h-8">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Efficient Response</h3>
          <p>We promise to quickly respond to client needs, providing timely consultation and service, ensuring client issues are promptly resolved.</p>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-sm text-center">
          <div class="w-16 h-16 bg-primary/10 text-primary rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-8 h-8">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Client First</h3>
          <p>We always put our clients' needs first, providing personalized insurance solutions and attentive service experiences, ensuring client satisfaction and peace of mind.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="container text-center">
      <h2 class="mb-6">Connect with Our Professional Team</h2>
      <p class="max-w-2xl mx-auto mb-8">If you have any insurance-related questions or needs, feel free to contact our professional team at any time. We are dedicated to serving you.</p>
      <a href={`/${lang}/contact`} class="btn-primary">Contact Us</a>
    </div>
  </section>

</BaseLayout>
