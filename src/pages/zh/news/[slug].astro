---
import NewsArticle from '../../../components/NewsArticle.astro';
import { getNews, splitId } from '../../../lib/news';

export async function getStaticPaths() {
  const items = await getNews('zh');
  return items.map(entry => ({ params: { slug: splitId(entry.id).slug }, props: { entry } }));
}

const { entry } = Astro.props;
---

<NewsArticle lang="zh" entry={entry} />
