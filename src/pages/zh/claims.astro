
---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Define the language
const lang = 'zh';

// Legal process between the client and the insurance company (not Apollo)
const claimSteps = [
  {
    step: 1,
    title: '事故现场处理',
    description: '如有人员受伤，请立即拨打911。随后请与对方共同填写事故处理单（Constat Amiable / 事故联合报告），并各自签字确认。签字仅用于确认事故双方身份及经过，并不代表承认责任。',
    icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z'
  },
  {
    step: 2,
    title: '通知您的保险公司',
    description: '请在合理时间内主动联系自己的保险公司，告知事故发生的经过，并提供保单号、事故时间地点等基本信息。',
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
  },
  {
    step: 3,
    title: '保险公司指派理赔专员',
    description: '保险公司会安排理赔专员（Adjuster）跟进您的案件，根据事故情况以及CID（撞车责任认定公约）等相关规则，评估责任归属。',
    icon: 'M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z'
  },
  {
    step: 4,
    title: '提交证明文件',
    description: '根据理赔专员的要求，提供相关证明文件，如警方报告（如适用）、事故照片、维修报价单、驾驶执照和车辆登记证等。',
    icon: 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z'
  },
  {
    step: 5,
    title: '理赔决定',
    description: '保险公司理赔专员完成评估后，会将赔付决定告知您，包括赔付金额和方式；如理赔被拒，也会说明原因并告知申诉途径。',
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'
  },
  {
    step: 6,
    title: '支付赔款',
    description: '理赔获批后，保险公司通常会通过银行转账等方式支付赔款。',
    icon: 'M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2z'
  }
];

// Supplementary support Apollo can offer — kept visually and semantically
// separate from the legal process above so clients don't mistake it for
// part of the insurer's claims procedure. Apollo is not licensed to
// adjust claims, so wording avoids implying Apollo makes claims decisions.
const apolloSupport = [
  {
    title: '语言与文件协助',
    description: '如果您与保险公司理赔专员沟通时遇到语言上的困难，或在准备、填写理赔相关文件时需要帮助，欢迎联系我们，我们可以从旁协助您整理资料。',
    icon: 'M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z'
  },
  {
    title: '进度催办',
    description: '如果您已经提供资料，但一两周内都没有收到保险公司理赔专员的回复，可以联系我们，我们可以帮您跟进催办。',
    icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'
  },
  {
    title: '沟通协助',
    description: '如果您与保险公司理赔专员之间出现意见不一致，也可以联系我们，我们可以协助您与保险公司沟通、询问情况。',
    icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z'
  },
  {
    title: '全程跟踪',
    description: '我们提供理赔追踪服务，会主动关注您的理赔进展并与您保持联系，直至理赔完全结束。',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01'
  }
];
---

<BaseLayout title="报险流程" lang={lang}>
  <section class="bg-gradient-to-r from-primary to-accent text-white py-12 md:py-16">
    <div class="container">
      <h1 class="text-center">报险流程</h1>
      <p class="text-center max-w-3xl mx-auto mt-4">了解如何快速、便捷地完成保险理赔程序</p>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="mb-6">保险公司理赔流程</h2>
        <p>以下是您与保险公司之间的标准理赔流程（依据魁北克相关法规及保单条款）。每一步的判断和决定，都由保险公司或其理赔专员负责。</p>
      </div>

      <div class="relative">
        <!-- 垂直时间线 (仅在大屏幕显示) -->
        <div class="hidden md:block absolute left-1/2 -ml-0.5 w-1 h-full bg-gray-200"></div>

        {claimSteps.map((step, index) => (
          <div class={`flex flex-col md:flex-row items-center md:items-start mb-12 last:mb-0 ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`}>
            <!-- 步骤数字圆圈 -->
            <div class="relative z-10 flex-shrink-0 flex items-center justify-center w-12 h-12 bg-primary text-white rounded-full font-bold mb-4 md:mb-0">
              {step.step}
            </div>

            <!-- 内容框 -->
            <div class={`flex-1 md:max-w-[calc(50%-2rem)] px-6 py-4 bg-light rounded-lg shadow-sm ${index % 2 === 0 ? 'md:mr-8 text-right' : 'md:ml-8'}`}>
              <div class={`flex items-start ${index % 2 === 0 ? 'flex-row-reverse' : ''}`}>
                <div class={`mt-1 text-primary ${index % 2 === 0 ? 'ml-4' : 'mr-4'}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={step.icon} />
                  </svg>
                </div>
                <div class={index % 2 === 0 ? 'text-right' : 'text-left'}>
                  <h3 class="text-xl font-semibold mb-2">{step.title}</h3>
                  <p>{step.description}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="max-w-3xl mx-auto mt-4 bg-white border border-gray-200 rounded-lg shadow-sm p-6">
        <h3 class="text-xl font-semibold mb-4 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          事故处理单（Constat Amiable）
        </h3>
        <p class="mb-4">事故处理单目前仅提供英语和法语的官方在线版本，您也可以下载法语原版空白表格，或对照中文参考翻译版填写。</p>
        <div class="flex flex-wrap gap-3">
          <a href="https://infoassurance.ca/en/joint-report" target="_blank" rel="noopener noreferrer" class="btn bg-light text-dark border border-gray-300 hover:bg-gray-100">在线填写（英语版）</a>
          <a href="https://infoassurance.ca/constat-amiable/" target="_blank" rel="noopener noreferrer" class="btn bg-light text-dark border border-gray-300 hover:bg-gray-100">在线填写（法语版）</a>
          <a href="/documents/constat-amiable-2023-fr.pdf" target="_blank" rel="noopener noreferrer" class="btn bg-light text-dark border border-gray-300 hover:bg-gray-100">下载法语原版（PDF）</a>
          <a href="/documents/constat-amiable-2023-cn.pdf" target="_blank" rel="noopener noreferrer" class="btn-primary">下载中文参考翻译版（PDF）</a>
        </div>
        <p class="mt-4 text-sm text-dark/70">中文参考翻译版仅供对照参考，如与法语原文有出入，以官方法语原文为准。填写并签署事故处理单不代表承认事故责任。</p>
      </div>
    </div>
  </section>

  <section class="py-12 bg-light">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-center mb-8">报险须知</h2>
        
        <div class="bg-white p-6 rounded-lg shadow-sm mb-6">
          <h3 class="text-xl font-semibold mb-4">重要提示</h3>
          <ul class="space-y-3">
            <li class="flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary mr-2 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>发生保险事故后，请尽快联系我们，以免延误理赔。</span>
            </li>
            <li class="flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary mr-2 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>保存所有相关证据，如事故照片、维修收据、医疗报告等。</span>
            </li>
            <li class="flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary mr-2 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>在严重事故中，请优先确保人身安全，并视情况通知警方和紧急服务部门。</span>
            </li>
          </ul>
        </div>
        
        <div class="bg-white p-6 rounded-lg shadow-sm">
          <h3 class="text-xl font-semibold mb-4">常见所需文件</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <h4 class="font-medium text-primary mb-2">房屋保险理赔</h4>
              <ul class="space-y-1">
                <li>• 财产损失清单</li>
                <li>• 损坏照片</li>
                <li>• 维修报价单</li>
                <li>• 购买收据（如有）</li>
                <li>• 警方报告（如适用）</li>
              </ul>
            </div>
            <div>
              <h4 class="font-medium text-primary mb-2">汽车保险理赔</h4>
              <ul class="space-y-1">
                <li>• 事故报告</li>
                <li>• 车辆损坏照片</li>
                <li>• 维修报价单</li>
                <li>• 驾驶执照和车辆登记证</li>
                <li>• 警方报告（如适用）</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-4">
        <h2 class="mb-6">阿波罗能为您提供的协助</h2>
        <p>以下服务由阿波罗保险公司作为客服支持提供，<strong>不属于保险公司的理赔流程</strong>。保险公司并未将理赔业务外包给我们，我们也没有理赔执照，理赔的最终判断与决定权始终在保险公司理赔专员手中，我们仅能提供辅助性的支持。</p>
      </div>

      <div class="max-w-3xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-6 mt-8">
        {apolloSupport.map((item) => (
          <div class="bg-white border-l-4 border-accent rounded-lg shadow-sm p-6">
            <div class="flex items-start">
              <div class="mt-1 text-accent mr-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold mb-2">{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="container text-center">
      <h2 class="mb-6">需要帮助？</h2>
      <p class="max-w-2xl mx-auto mb-8">如果您对理赔流程有任何疑问，或需要提交索赔，请随时联系我们的客服团队，我们将为您提供专业的中文服务支持。</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={`/${lang}/contact`} class="btn-primary">联系我们</a>
        <a href={`/${lang}/faq`} class="btn bg-light text-dark border border-gray-300 hover:bg-gray-100">查看常见问题</a>
      </div>
    </div>
  </section>
</BaseLayout>
