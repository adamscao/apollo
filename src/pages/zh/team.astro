
---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Define the language
const lang = 'zh';

// 公司总机，全体成员统一
const MAIN_PHONE = '450-676-3356';

// Team members data
const teamMembers = [
  {
    name: '曹梦阳（Jacques）',
    title: '总经理',
    direct: '450-912-6302',
    extension: '324',
    email: 'jcao@assurancespv.com',
    wechat: '/team/cao.jpg'
  },
  {
    name: '许媛媛（Justine）',
    title: '客户经理',
    direct: '450-912-6305',
    extension: '323',
    email: 'jxu@assurancespv.com',
    wechat: '/team/xu.jpg'
  },
  {
    name: '李辉（Lily）',
    title: '客户经理',
    direct: '450-912-6303',
    extension: '303',
    email: 'lli@assurancespv.com',
    wechat: '/team/li.jpg'
  },
  {
    name: '武冬梅（May）',
    title: '客户经理',
    direct: '450-912-6304',
    extension: '334',
    email: 'mwu@assurancespv.com',
    wechat: '/team/wu.jpg'
  },
  {
    name: '裴小佳（Brigitte）',
    title: '客户经理',
    direct: '450-912-4835',
    extension: '336',
    email: 'bpei@assurancespv.com',
    wechat: '/team/pei.jpg'
  },
  {
    name: 'Lucie Dagenais',
    title: '会计部负责人',
    direct: '450-676-7707',
    email: 'interac@assurancespv.com',
    tip: '💡 付款小贴士：如需通过 e-Transfer 直接付款，请转账至 interac@assurancespv.com（注意：首字母是小写字母 i）。安全问题请选择"service rendu"，答案填写"assurance"；并请在备注中注明您的姓名及保单号。'
  },
  {
    name: 'France Robidoux',
    title: '商业保险助理',
    extension: '329',
    email: 'frobidoux@assurancespv.com',
    tip: '💡 查找商业保单：如需查找您的商业电子保单，请在邮箱中搜索 frobidoux@assurancespv.com，我们所有的商业保单都是通过该邮箱发送的；如果找不到，请检查垃圾邮件文件夹。'
  }
];
---

<BaseLayout title="团队介绍" lang={lang}>
  <section class="bg-gradient-to-r from-primary to-accent text-white py-12 md:py-16">
    <div class="container">
      <h1 class="text-center">团队介绍</h1>
      <p class="text-center max-w-3xl mx-auto mt-4">我们的专业团队致力于为您提供最优质的保险服务</p>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="mb-6">认识我们的团队</h2>
        <p>阿波罗保险公司拥有一支专业、敬业的团队，每位成员都拥有丰富的保险行业经验，致力于为客户提供专业、贴心的服务。我们的团队成员精通中文和当地官方语言，能够为您提供母语服务，消除沟通障碍。</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {teamMembers.map((member) => (
          <div class="bg-light rounded-lg overflow-hidden shadow-sm p-6">
            <h3 class="text-xl font-semibold mb-1">{member.name}</h3>
            <p class="text-primary font-medium mb-3">{member.title}</p>
            <div class="space-y-1 text-gray-700">
              <p>总机：{MAIN_PHONE}{member.extension ? ` 转 ${member.extension}` : ''}</p>
              {member.direct && <p>直拨：{member.direct}</p>}
            </div>
            <p class="mt-1 mb-3">邮箱：<a href={`mailto:${member.email}`} class="hover:text-primary">{member.email}</a></p>
            {member.tip && (
              <div class="mb-3 p-3 bg-white border-l-4 border-secondary rounded text-sm text-gray-600">{member.tip}</div>
            )}
            {member.wechat && (
              <div class="pt-3 border-t border-gray-200 flex items-center gap-3">
                <img src={member.wechat} alt={`${member.name}微信二维码`} class="w-20 h-20 object-cover rounded-lg border border-gray-200" />
                <span class="text-sm text-gray-600">微信二维码</span>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-light">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="mb-6">我们的承诺</h2>
        <p>作为阿波罗保险公司的团队成员，我们承诺为每位客户提供专业、诚信、高效的服务，帮助您选择最适合的保险方案，保护您的财产和利益。</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-8 rounded-lg shadow-sm text-center">
          <div class="w-16 h-16 bg-primary/10 text-primary rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-8 h-8">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">专业诚信</h3>
          <p>我们以专业知识和诚信态度，为客户提供透明、可靠的保险服务，建立长期互信关系。</p>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-sm text-center">
          <div class="w-16 h-16 bg-primary/10 text-primary rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-8 h-8">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">高效响应</h3>
          <p>我们承诺快速响应客户需求，提供及时的咨询和服务，确保客户的问题得到迅速解决。</p>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-sm text-center">
          <div class="w-16 h-16 bg-primary/10 text-primary rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-8 h-8">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">客户至上</h3>
          <p>我们始终将客户的需求放在首位，提供个性化的保险方案和贴心的服务体验，让客户感到满意和安心。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="container text-center">
      <h2 class="mb-6">与我们的专业团队沟通</h2>
      <p class="max-w-2xl mx-auto mb-8">如果您有任何保险相关的问题或需求，欢迎随时联系我们的专业团队，我们将竭诚为您服务。</p>
      <a href={`/${lang}/contact`} class="btn-primary">联系我们</a>
    </div>
  </section>

</BaseLayout>
