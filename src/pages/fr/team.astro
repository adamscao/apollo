  },
  {
    name: '许媛媛 (Justine)',
    title: 'Gestionnaire de Compte',
    direct: '450-912-6305',
    extension: '323',
    email: 'jxu@assurancespv.com',
    wechat: '/team/xu.jpg'
  },
  {
    name: '李辉 (Lily)',
    title: 'Gestionnaire de Compte',
    direct: '450-912-6303',
    extension: '303',
    email: 'lli@assurancespv.com',
    wechat: '/team/li.jpg'
  },
  {
    name: '武冬梅 (May)',
    title: 'Gestionnaire de Compte',
    direct: '450-912-6304',
    extension: '334',
    email: 'mwu@assurancespv.com',
    wechat: '/team/wu.jpg'
  },
  {
    name: '裴小佳 (Brigitte)',
    title: 'Gestionnaire de Compte',
    direct: '450-912-4835',
    extension: '336',
    email: 'bpei@assurancespv.com',
    wechat: '/team/pei.jpg'
  },
  {
    name: 'Lucie Dagenais',
    title: 'Responsable du Service de la Comptabilité',
    direct: '450-676-7707',
    email: 'interac@assurancespv.com',
    tip: '💡 Astuce de paiement : Pour payer par virement Interac, envoyez à interac@assurancespv.com (attention : la première lettre est un « i » minuscule). Question de sécurité : « service rendu », réponse : « assurance ». Veuillez indiquer votre nom et votre numéro de police dans le commentaire.'
  },
  {
    name: 'France Robidoux',
    title: 'Adjointe, Assurance des Entreprises',
    extension: '329',
    email: 'frobidoux@assurancespv.com',
    tip: "💡 Retrouver votre police : Pour retrouver votre police d'assurance des entreprises électronique, recherchez dans vos courriels l'adresse frobidoux@assurancespv.com — toutes nos polices électroniques sont envoyées à partir de cette adresse. Si vous ne la trouvez pas, veuillez vérifier votre dossier de courrier indésirable."
  }
