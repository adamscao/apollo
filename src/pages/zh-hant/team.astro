
---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Define the language
const lang = 'zh-hant';

// 公司總機，全體成員統一
const MAIN_PHONE = '450-676-3356';

// Team members data
const teamMembers = [
  {
    name: '曹夢陽（Jacques）',
    title: '總經理',
    direct: '450-912-6302',
    extension: '324',
    email: 'jcao@assurancespv.com',
    wechat: '/team/cao.jpg'
  },
  {
    name: '許媛媛（Justine）',
    title: '客戶經理',
    direct: '450-912-6305',
    extension: '323',
    email: 'jxu@assurancespv.com',
    wechat: '/team/xu.jpg'
  },
  {
    name: '李輝（Lily）',
    title: '客戶經理',
    direct: '450-912-6303',
    extension: '303',
    email: 'lli@assurancespv.com',
    wechat: '/team/li.jpg'
  },
  {
    name: '伍冬梅（May）',
    title: '客戶經理',
    direct: '450-912-6304',
    extension: '334',
    email: 'mwu@assurancespv.com',
    wechat: '/team/wu.jpg'
  },
  {
    name: '裴小佳（Brigitte）',
    title: '客戶經理',
    direct: '450-912-4835',
    extension: '336',
    email: 'bpei@assurancespv.com',
    wechat: '/team/pei.jpg'
  },
  {
    name: 'Lucie Dagenais',
    title: '會計部負責人',
    direct: '450-676-7707',
    email: 'interac@assurancespv.com',
    tip: '💡 付款小貼士：如需通過 e-Transfer 直接付款，請轉賬至 interac@assurancespv.com（注意：首字母是小寫字母 i）。安全問題請選擇"service rendu"，答案填寫"assurance"；並請在備註中註明您的姓名及保單號。'
  },
  {
    name: 'France Robidoux',
    title: '商業保險助理',
    extension: '329',
    email: 'frobidoux@assurancespv.com',
    tip: '💡 查找商業保單：如需查找您的商業電子保單，請在郵箱中搜索 frobidoux@assurancespv.com，我們所有的商業保單都是通過該郵箱發送的；如果找不到，請檢查垃圾郵件文件夾。'
  }
];
---

<BaseLayout title="團隊介紹" lang={lang}>
  <section class="bg-gradient-to-r from-primary to-accent text-white py-12 md:py-16">
    <div class="container">
      <h1 class="text-center">團隊介紹</h1>
      <p class="text-center max-w-3xl mx-auto mt-4">我們的專業團隊致力於為您提供最優質的保險服務</p>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="mb-6">認識我們的團隊</h2>
        <p>阿波羅保險公司擁有一支專業、敬業的團隊，每位成員都擁有豐富的保險行業經驗，致力於為客戶提供專業、貼心的服務。我們的團隊成員精通法語、英語、普通話、粵語，能夠用您熟悉的語言為您服務，消除溝通障礙。</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {teamMembers.map((member) => (
          <div class="bg-light rounded-lg overflow-hidden shadow-sm p-6">
            <h3 class="text-xl font-semibold mb-1">{member.name}</h3>
            <p class="text-primary font-medium mb-3">{member.title}</p>
            <div class="space-y-1 text-gray-700">
              <p>總機：{MAIN_PHONE}{member.extension ? ` 轉 ${member.extension}` : ''}</p>
              {member.direct && <p>直撥：{member.direct}</p>}
            </div>
            <p class="mt-1 mb-3">郵箱：<a href={`mailto:${member.email}`} class="hover:text-primary">{member.email}</a></p>
            {member.tip && (
              <div class="mb-3 p-3 bg-white border-l-4 border-secondary rounded text-sm text-gray-600">{member.tip}</div>
            )}
            {member.wechat && (
              <div class="pt-3 border-t border-gray-200">
                <img src={member.wechat} alt={`${member.name}微信二維碼`} class="w-40 h-40 object-cover rounded-lg border border-gray-200" />
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-light">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="mb-6">我們的承諾</h2>
        <p>作為阿波羅保險公司的團隊成員，我們承諾為每位客戶提供專業、誠信、高效的服務，幫助您選擇最適合的保險方案，保護您的財產和利益。</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-8 rounded-lg shadow-sm text-center">
          <div class="w-16 h-16 bg-primary/10 text-primary rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-8 h-8">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">專業誠信</h3>
          <p>我們以專業知識和誠信態度，為客戶提供透明、可靠的保險服務，建立長期互信關係。</p>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-sm text-center">
          <div class="w-16 h-16 bg-primary/10 text-primary rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-8 h-8">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">高效響應</h3>
          <p>我們承諾快速響應客戶需求，提供及時的諮詢和服務，確保客戶的問題得到迅速解決。</p>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-sm text-center">
          <div class="w-16 h-16 bg-primary/10 text-primary rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-8 h-8">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">客戶至上</h3>
          <p>我們始終將客戶的需求放在首位，提供個性化的保險方案和貼心的服務體驗，讓客戶感到滿意和安心。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="container text-center">
      <h2 class="mb-6">與我們的專業團隊溝通</h2>
      <p class="max-w-2xl mx-auto mb-8">如果您有任何保險相關的問題或需求，歡迎隨時聯絡我們的專業團隊，我們將竭誠為您服務。</p>
      <a href={`/${lang}/contact`} class="btn-primary">聯絡我們</a>
    </div>
  </section>

</BaseLayout>
