
---
// Import components and styles
import Logo from '../components/Logo.astro';
import '../styles/global.css';

// Define props
export interface Props {
  title: string;
  description?: string;
  lang: 'zh' | 'zh-hant' | 'en' | 'fr';
}

// Destructure props with defaults
const { 
  title, 
  description = "阿波罗保险公司 - 专业的房屋、汽车和商业保险服务", 
  lang = "zh"
} = Astro.props;

// Language mapping for UI elements
const currentYear = new Date().getFullYear();

const uiText = {
  zh: {
    home: "首页",
    about: "公司介绍",
    services: "服务介绍",
    team: "团队介绍",
    claims: "报险流程",
    faq: "常见问题",
    news: "新闻动态",
    contact: "联系我们",
    footer: {
      rights: `版权所有 © ${currentYear} 阿波罗保险公司`,
      backToTop: "返回顶部"
    }
  },
  'zh-hant': {
    home: "首頁",
    about: "公司介紹",
    services: "服務介紹",
    team: "團隊介紹",
    claims: "報險流程",
    faq: "常見問題",
    news: "新聞動態",
    contact: "聯絡我們",
    footer: {
      rights: `版權所有 © ${currentYear} 阿波羅保險公司`,
      backToTop: "返回頂部"
    }
  },
  en: {
    home: "Home",
    about: "About",
    services: "Services",
    team: "Our Team",
    claims: "Claims",
    faq: "FAQ",
    news: "News",
    contact: "Contact",
    footer: {
      rights: `Copyright © ${currentYear} Apollo Insurance`,
      backToTop: "Back to Top"
    }
  },
  fr: {
    home: "Accueil",
    about: "À Propos",
    services: "Services",
    team: "Notre Équipe",
    claims: "Réclamations",
    faq: "FAQ",
    news: "Actualités",
    contact: "Contact",
    footer: {
      rights: `Droits d'auteur © ${currentYear} Assurance Apollo`,
      backToTop: "Haut de Page"
    }
  }
};

// Define current UI text based on language
const ui = uiText[lang];

// Navigation links with localized paths
const navLinks = [
  { label: ui.home, path: `/${lang}` },
  { label: ui.about, path: `/${lang}/about` },
  { label: ui.services, path: `/${lang}/services` },
  { label: ui.team, path: `/${lang}/team` },
  { label: ui.claims, path: `/${lang}/claims` },
  { label: ui.faq, path: `/${lang}/faq` },
  { label: ui.news, path: `/${lang}/news` },
  { label: ui.contact, path: `/${lang}/contact` }
];

// Current path for highlighting active links
const currentPath = Astro.url.pathname;

// Language switcher targets: swap the locale prefix of the current path.
// 'zh-hant' must be matched before 'zh' so it isn't read as '/zh' + '-hant'.
// Flags (public/flags, from the MIT-licensed flag-icons package): Traditional
// Chinese deliberately uses the Hong Kong flag.
const languages = [
  { code: 'zh', label: '简体中文', flag: '/flags/cn.svg' },
  { code: 'zh-hant', label: '繁體中文', flag: '/flags/hk.svg' },
  { code: 'en', label: 'English', flag: '/flags/gb.svg' },
  { code: 'fr', label: 'Français', flag: '/flags/fr.svg' }
].map(l => ({ ...l, path: currentPath.replace(/^\/(zh-hant|zh|en|fr)(?=\/|$)/, `/${l.code}`) }));

// Chinese variants share most footer copy; pick by script where it differs.
const isZh = lang === 'zh' || lang === 'zh-hant';
const zhT = (hans: string, hant: string) => (lang === 'zh-hant' ? hant : hans);
---

<!doctype html>
<html lang={lang === 'zh-hant' ? 'zh-Hant' : lang === 'zh' ? 'zh-Hans' : lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Apollo Insurance</title>
  </head>
  <body>
    <header class="bg-white shadow-md fixed w-full top-0 z-50">
      <div class="container py-4">
        <div class="flex justify-between items-center gap-4">
          <!-- Logo -->
          <a href={`/${lang}`} class="flex items-center gap-2 md:gap-3 text-primary font-bold text-xl md:text-2xl whitespace-nowrap">
            <Logo class="h-9 w-9 md:h-12 md:w-12 shrink-0" />
            {isZh ? zhT('阿波罗保险公司', '阿波羅保險公司') : lang === 'fr' ? 'Assurance Apollo' : 'Apollo Insurance'}
          </a>

          <div class="flex items-center gap-4 xl:gap-6">
            <!-- Desktop Navigation -->
            <nav class="hidden lg:flex items-center space-x-3 xl:space-x-6 whitespace-nowrap">
              {navLinks.map(link => (
                <a 
                  href={link.path} 
                  class={`hover:text-primary transition-colors ${currentPath === link.path ? 'text-primary font-semibold' : 'text-dark'}`}
                >
                  {link.label}
                </a>
              ))}
            </nav>

            <!-- Language Selector: always visible, one flag per language -->
            <div class="flex items-center gap-2">
              {languages.map(l => (
                <a
                  href={l.path}
                  title={l.label}
                  aria-label={l.label}
                  hreflang={l.code === 'zh-hant' ? 'zh-Hant' : l.code === 'zh' ? 'zh-Hans' : l.code}
                  aria-current={lang === l.code ? 'true' : undefined}
                  class={`block rounded-sm transition ${lang === l.code ? 'ring-2 ring-primary ring-offset-1' : 'opacity-60 hover:opacity-100'}`}
                >
                  <img src={l.flag} alt="" width="24" height="18" class="block w-6 h-[18px] rounded-sm border border-gray-200 object-cover" />
                </a>
              ))}
            </div>

            <!-- Mobile Menu Button -->
            <button id="menu-toggle" class="lg:hidden text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile Navigation -->
        <div id="mobile-menu" class="lg:hidden hidden pt-4 pb-2">
          <nav class="flex flex-col space-y-4">
            {navLinks.map(link => (
              <a 
                href={link.path} 
                class={`hover:text-primary transition-colors ${currentPath === link.path ? 'text-primary font-semibold' : 'text-dark'}`}
              >
                {link.label}
              </a>
            ))}
          </nav>
        </div>
      </div>
    </header>

    <main class="pt-24 pb-12 min-h-[calc(100vh-64px)]">
      <slot />
    </main>

    <footer class="bg-primary text-white py-8">
      <div class="container">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <!-- Company Info -->
          <div class="col-span-1 md:col-span-2">
            <h3 class="text-xl font-bold mb-4">
              {isZh ? zhT('阿波罗保险公司', '阿波羅保險公司') : lang === 'fr' ? 'Assurance Apollo' : 'Apollo Insurance'}
            </h3>
            <p class="mb-4 text-sm md:text-base">
              {isZh
                ? zhT('阿波罗保险公司是Assurances Provencher Verreault的合作伙伴，位于加拿大蒙特利尔南岸Brossard，专注为客户提供专业的保险服务。',
                      '阿波羅保險公司是Assurances Provencher Verreault的合作夥伴，位於加拿大蒙特利爾南岸Brossard，專注為客戶提供專業的保險服務。')
                : lang === 'fr'
                  ? 'Assurance Apollo est un partenaire d\'Assurances Provencher Verreault, située à Brossard sur la Rive-Sud de Montréal, Québec, Canada, spécialisée dans les services d\'assurance pour une clientèle diversifiée.'
                  : 'Apollo Insurance is a partner of Assurances Provencher Verreault, located in Brossard on the South Shore of Montreal, Quebec, Canada, specializing in professional insurance services for our clients.'}
            </p>
          </div>

          <!-- Services -->
          <div>
            <h4 class="text-lg font-semibold mb-3">
              {isZh ? zhT('服务', '服務') : lang === 'fr' ? 'Services' : 'Services'}
            </h4>
            <ul class="space-y-2">
              <li>
                <a href={`/${lang}/services#home`} class="hover:text-secondary transition-colors">
                  {isZh ? zhT('房屋保险', '房屋保險') : lang === 'fr' ? 'Assurance Habitation' : 'Home Insurance'}
                </a>
              </li>
              <li>
                <a href={`/${lang}/services#auto`} class="hover:text-secondary transition-colors">
                  {isZh ? zhT('汽车保险', '汽車保險') : lang === 'fr' ? 'Assurance Auto' : 'Auto Insurance'}
                </a>
              </li>
              <li>
                <a href={`/${lang}/services#business`} class="hover:text-secondary transition-colors">
                  {isZh ? zhT('商业保险', '商業保險') : lang === 'fr' ? 'Assurance des Entreprises' : 'Business Insurance'}
                </a>
              </li>
            </ul>
          </div>

          <!-- Contact -->
          <div>
            <h4 class="text-lg font-semibold mb-3">
              {isZh ? zhT('联系我们', '聯絡我們') : lang === 'fr' ? 'Contactez-nous' : 'Contact Us'}
            </h4>
            <address class="not-italic">
              <p class="mb-1">620-7055 boulevard Taschereau</p>
              <p class="mb-1">Brossard (Québec) J4Z 1A7</p>
              <p class="mb-1">
                <a href="tel:+14506763356" class="hover:text-secondary transition-colors">
                  (450) 676-3356 {isZh ? zhT('(法语)', '(法語)') : lang === 'fr' ? '(Français)' : '(French)'}
                </a>
              </p>
              <p class="mb-1">
                <a href="tel:+14509126302" class="hover:text-secondary transition-colors">
                  (450) 912-6302
                </a>
              </p>
              <p>
                <a href="mailto:info@apolloins.ca" class="hover:text-secondary transition-colors">
                  info@apolloins.ca
                </a>
              </p>
            </address>
          </div>
        </div>

        <div class="border-t border-gray-700 mt-8 pt-8 flex flex-col md:flex-row justify-between items-center">
          <p class="text-sm mb-4 md:mb-0">{ui.footer.rights}</p>
          <a href="#" class="text-sm flex items-center hover:text-secondary transition-colors">
            <span>{ui.footer.backToTop}</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-4 h-4 ml-1">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
            </svg>
          </a>
        </div>
      </div>
    </footer>

    <script>
      // Mobile menu toggle
      document.addEventListener('DOMContentLoaded', () => {
        const menuToggle = document.getElementById('menu-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        
        if (menuToggle && mobileMenu) {
          menuToggle.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
          });
        }
      });
    </script>
  </body>
</html>
